{
  "description": "Reflex pre-execution gate, instruction layer and prompt injection guard for Claude Code. Stands down when reflex setup already installed the same hooks in settings.json.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|Task|Agent|Edit|Write|MultiEdit|NotebookEdit)$|^mcp__",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hook.mjs\" \"${CLAUDE_PLUGIN_ROOT}/gate.mjs\" --claude --plugin",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hook.mjs\" \"${CLAUDE_PLUGIN_ROOT}/gate.mjs\" --claude-post --plugin",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "^(WebFetch|WebSearch|Read|Bash)$|^mcp__",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hook.mjs\" \"${CLAUDE_PLUGIN_ROOT}/guard.mjs\" --claude --plugin",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hook.mjs\" \"${CLAUDE_PLUGIN_ROOT}/gate.mjs\" --claude-post --plugin",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "matcher": "Bash|Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hook.mjs\" \"${CLAUDE_PLUGIN_ROOT}/gate.mjs\" --claude-post --plugin",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash|Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hook.mjs\" \"${CLAUDE_PLUGIN_ROOT}/gate.mjs\" --claude-prompted --plugin",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hook.mjs\" \"${CLAUDE_PLUGIN_ROOT}/instructions.mjs\" --claude --plugin",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hook.mjs\" \"${CLAUDE_PLUGIN_ROOT}/guard.mjs\" --claude-prompt --plugin",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
