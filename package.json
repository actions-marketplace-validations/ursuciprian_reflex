{
  "name": "@ursuciprian/reflex",
  "version": "0.14.0",
  "description": "Open-source pre-execution risk gate and prompt injection guard for AI coding agents (Claude Code, Codex CLI, opencode, pi, oh-my-pi, Hermes): local rules, optional TypeSafe Jev (System One) or local Laya judgments, an editable policy, System 2 escalation and a human approval queue",
  "keywords": [
    "ai-coding-agents",
    "coding-agents",
    "claude-code",
    "claude-code-hooks",
    "claude-code-plugin",
    "codex",
    "codex-cli",
    "codex-plugin",
    "opencode",
    "opencode-plugin",
    "pre-execution-hook",
    "command-approval",
    "guardrails",
    "llm-guardrails",
    "agent-security",
    "prompt-injection",
    "human-in-the-loop",
    "autonomous-agents",
    "devsecops",
    "jev",
    "typesafe",
    "system-one",
    "laya",
    "mcp",
    "hooks",
    "policy",
    "shell",
    "security",
    "claude-code-security",
    "codex-guardrails",
    "coding-agent-guardrails",
    "ai-agent-security",
    "tool-call-gating",
    "permission-prompts",
    "prompt-injection-protection",
    "pre-tool-use",
    "pi",
    "oh-my-pi",
    "hermes",
    "deploy-freeze",
    "change-management",
    "audit-log",
    "mcp-server",
    "model-context-protocol",
    "claude-desktop",
    "cursor"
  ],
  "license": "MIT",
  "author": "Ciprian Ursu",
  "homepage": "https://github.com/ursuciprian/reflex#readme",
  "bugs": {
    "url": "https://github.com/ursuciprian/reflex/issues"
  },
  "type": "module",
  "main": "adapters/opencode.js",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "reflex": "bin/reflex"
  },
  "files": [
    "*.mjs",
    ".claude-plugin/",
    ".codex-plugin/",
    ".agents/",
    ".mcp.json",
    "hooks/",
    "commands/",
    "skills/",
    "adapters/",
    "bin/",
    "dashboards/",
    "docs/",
    "examples/",
    "router/",
    "routing/",
    "setup/",
    "install.sh",
    "README.md",
    "llms.txt",
    "llms-full.txt",
    "CITATION.cff"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ursuciprian/reflex.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node test.mjs",
    "eval": "node eval.mjs",
    "eval-instructions": "node eval-instructions.mjs",
    "eval-injection": "node guard.mjs --eval",
    "eval-ladder": "node eval-ladder.mjs",
    "eval-context": "node context.mjs --eval-context",
    "eval-router": "node router/server.mjs --eval",
    "eval-routing": "python3 routing/reflex_router.py --eval",
    "eval-compare": "node eval-compare.mjs",
    "report": "node report.mjs",
    "install-hook": "node install.mjs"
  }
}
