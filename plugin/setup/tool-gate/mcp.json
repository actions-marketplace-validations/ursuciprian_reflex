{
  "version": "mcp-v1",
  "note": "MCP tool calls (tools.mjs). A rule matches when each of its patterns does: `server` on the server name (the whole tool name when the agent does not say which server), `tool` on the tool name as words (deleteStack and delete-stack are delete_stack), `args` on the arguments as JSON. Patterns are case-insensitive. `prod: deny` turns the ask into a deny when the arguments or the server point at production (the prod-destroy markers and a team policy's prod list). A shell command in an argument (command, cli_command, cmd, script) goes through the shell rules. After the rules, a tool whose name starts with a `read` verb passes (a SQL argument must be SELECT only); anything else is unknown: logged in shadow and keyless, judged by Jev when enforcing with a key, or an ask with config.json mcp.unknown \"ask\". A copy in ~/.config/reflex/tool-gate/mcp.json replaces this file; a team policy can only add rules.",
  "read": [
    "get",
    "list",
    "describe",
    "search",
    "read",
    "query",
    "fetch",
    "find",
    "show",
    "view",
    "lookup",
    "count",
    "inspect",
    "explain",
    "preview",
    "diff",
    "validate",
    "analyze",
    "summarize",
    "retrieve",
    "browse",
    "recall",
    "check",
    "info",
    "whoami",
    "status",
    "ls",
    "cat",
    "head",
    "tail",
    "grep",
    "glob",
    "tree",
    "stat",
    "estimate",
    "compare",
    "wait",
    "screenshot"
  ],
  "sql_verbs": [
    "sql",
    "query",
    "execute",
    "exec",
    "run",
    "statement"
  ],
  "pass_note": "`pass`: calls that pass like a read once no rule asked: browser navigation (not fill, type, upload or scripts, which can carry data out), local agent memory, an HTTP GET. Measured on 30 days of Claude Code transcripts, these were most of the calls left unknown.",
  "pass": [
    {
      "rule": "browser navigation",
      "server": "chrome|browser|playwright|puppeteer",
      "tool": "^(navigate|click|hover|scroll|resize|wait|new_page|new_tab|close_page|close_tab|select_page|switch|tabs|press_key|emulate|find|get_page|take_screenshot|take_snapshot)"
    },
    {
      "rule": "library docs",
      "server": "context7|docs",
      "tool": "^resolve_library_id$"
    },
    {
      "rule": "local agent memory",
      "server": "memory|(^|[^a-z])mem([^a-z]|$)|cortex|deja|claude-mem",
      "tool": "^(remember|store|save|add|create_entities|create_relations|add_observations|recall)"
    },
    {
      "rule": "an HTTP GET",
      "tool": "(^|_)(request|http|fetch|call_api|api)(_|$)",
      "args": "\"method\"\\s*:\\s*\"(get|head|options)\""
    },
    {
      "rule": "an HTTP GET (no method, no body)",
      "tool": "(^|_)(request|http|fetch|call_api|api)(_|$)",
      "args": "^(?![\\s\\S]*\"[^\"]*(method|verb)[^\"]*\"\\s*:)(?![\\s\\S]*\"(body|data|payload|json|form)\"\\s*:)"
    }
  ],
  "rules": [
    {
      "id": "mcp-destructive",
      "outcome": "ask",
      "prod": "deny",
      "rule": "destructive MCP tool call",
      "tool": "(^|_)(delete|destroy|drop|terminate|remove|rm|purge|truncate|force|reset|rollback|uninstall|wipe|erase|revoke|detach|deregister|kill|flush|flushall|flushdb|unlink|rmdir|overwrite|shutdown)(_|$)"
    },
    {
      "id": "mcp-scale-to-zero",
      "outcome": "ask",
      "prod": "deny",
      "rule": "scales a workload to zero through MCP",
      "tool": "(^|_)scale(_|$)",
      "args": "\"(replicas|desired_?count|desired_?capacity|count|size|min_?size|max_?size)\"\\s*:\\s*\"?0\"?\\s*[,}]"
    },
    {
      "id": "mcp-scale-to-zero",
      "outcome": "ask",
      "prod": "deny",
      "rule": "scales a workload to zero through MCP",
      "tool": "(^|_)scale_to_zero(_|$)"
    },
    {
      "id": "mcp-bucket-policy",
      "outcome": "ask",
      "prod": "deny",
      "rule": "changes an S3 bucket policy, ACL or public access block through MCP",
      "tool": "(^|_)put_(bucket_(policy|acl|cors|lifecycle(_configuration)?|ownership_controls)|public_access_block)(_|$)"
    },
    {
      "id": "mcp-security-group",
      "outcome": "ask",
      "prod": "deny",
      "rule": "changes a security group through MCP",
      "tool": "(^|_)(update|modify|authorize|create)_security_groups?(_|$)|(^|_)authorize_security_group"
    },
    {
      "id": "mcp-iam",
      "outcome": "ask",
      "prod": "deny",
      "rule": "changes IAM permissions through MCP",
      "tool": "(^|_)(put|attach)_(role|user|group)_policy(_|$)|(^|_)create_(access_key|login_profile|policy_version|service_linked_role)(_|$)|(^|_)update_assume_role_policy(_|$)|(^|_)add_user_to_group(_|$)"
    },
    {
      "id": "mcp-iam",
      "outcome": "ask",
      "prod": "deny",
      "rule": "changes IAM permissions through MCP",
      "server": "(^|[^a-z])iam([^a-z]|$)",
      "tool": "^(put|attach|create|update|add|set)_"
    },
    {
      "id": "mcp-sql-destructive",
      "outcome": "ask",
      "prod": "deny",
      "rule": "runs destructive SQL through MCP",
      "sql": "^[\\s(]*(drop|truncate|delete|alter)\\b|\\bdelete\\s+from\\b|\\bdrop\\s+(table|database|schema)\\b"
    },
    {
      "id": "mcp-http-delete",
      "outcome": "ask",
      "prod": "deny",
      "rule": "sends an HTTP DELETE through MCP",
      "args": "\"[^\"]*(method|verb)[^\"]*\"\\s*:\\s*\"delete\""
    }
  ]
}
