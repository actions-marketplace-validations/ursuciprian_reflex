#!/usr/bin/env node
// reflex <command>: one entry point for the package.
//   reflex setup [--agents a,b] [--mode M] [--allow A] [--keychain NAME] [--node PATH]
//                [--provider typesafe|openrouter|cloudflare|vercel|compatible] [--provider-url U] [--cloudflare-account ID]
//                                                      install into ~/.local/share/reflex and hook
//                                                      every agent found (what curl / npx / pnpm dlx /
//                                                      bunx / yarn dlx run)
//   reflex setup --profile supervised|autonomous [--judge on|off --judge-url U --judge-model M ...]
//                                                      presets; flags beside a profile win
//   reflex queue [list|show|approve|deny|clear]        the async human queue (autonomous profile)
//   reflex envelope set "<text>" | show | list | clear what the agent may do for this task
//   reflex checkpoints [list|restore <name>]           recovery points taken before mutations
//   reflex runaway [list|reset <session>|reset --all]  sessions the runaway guard stopped; lift a stop
//   reflex check "<cmd>" [--cwd dir] [--intent text]   judge one command
//   reflex scan <file|-> [--rewrite]                  judge text for prompt injection (exit 0 pass, 1 warn, 2 block)
//   reflex policy [dir] | reflex policy init [dir]     this repo's team policy (.reflex/policy.json) | write a starter
//   reflex policy init [dir] --pack <name>             write a policy pack instead: aws, eks, terraform, startup-default
//   reflex trust [dir] | reflex trust --revoke [dir]   let this repo's team fast lane apply (hash-bound, terminal only)
//   reflex report [...]                                what the gate has been doing
//   reflex audit [--since 7d] [--format csv|json|jsonl] [--prod-only] [--agent a]
//                                                      one row per decision, for change management evidence
//   reflex replay [claude|codex|opencode|pi|all] [--since 7d] [--engine local|jev|laya] [--json]
//                                                      what the gate would have done with past sessions (nothing runs)
//   reflex suggest [agent] [--since 30d] [--min N] [--json] [--write [--yes]]
//                                                      fast-lane entries for what keeps asking (fastlane.json)
//   reflex learn [--since 30d] [--min N] [--json] [--write [--yes]] [--team] [--list] [--forget id] [--prune]
//                                                      fast-lane entries from what you approved yourself
//   reflex bench [--engine local|jev|laya] [--json]      precheck and engine latency, spend estimate
//   reflex install [...]                               re-wire agents (install.mjs flags)
//   reflex uninstall                                   remove every hook, the package and its link
//   reflex setup --engine laya [--dry-run]             local System 1: a Laya server on 127.0.0.1 (no key)
//   reflex laya start|stop|status|install-service      the Laya server's lifecycle (laya.mjs)
//   reflex mcp                                         an MCP server on stdio (mcp.mjs): read-only, advisory tools
//                                                      for Claude Desktop, Cursor, Cowork and any MCP host
//   reflex test | eval                                 offline selfchecks | live golden set
//   reflex version
import {spawnSync} from "node:child_process";
import {closeSync, copyFileSync, cpSync, existsSync, mkdirSync, openSync, readFileSync, readSync, realpathSync,
        renameSync, rmSync, symlinkSync, writeFileSync, writeSync} from "node:fs";
import {homedir, platform} from "node:os";
import {dirname, join} from "node:path";
import {fileURLToPath} from "node:url";
import {JUDGE_BACKENDS, QUEUE_DEFAULTS, USER_CONFIG, USER_CONFIG_ERROR, USER_CONFIG_FILE, judgeSettings, policyDirectory} from "../gate.mjs";
import {onPath} from "../judge2.mjs";
import {PROVIDERS, detect, envKey, hostOf, providerError, providerUrl} from "../providers.mjs";
import {isMain} from "../failsafe.mjs";

const ROOT = join(dirname(realpathSync(fileURLToPath(import.meta.url))), "..");
const [cmd, ...args] = process.argv.slice(2);
const ENV = process.env;
const PREFIX = ENV.REFLEX_PREFIX ?? join(homedir(), ".local/share/reflex");
// The stable home of the package: hooks point here, so it must outlive npx / pnpm dlx caches.
const TARGET = join(PREFIX, "lib/node_modules/@ursuciprian/reflex");
const BIN_LINK = join(homedir(), ".local/bin/reflex");
const version = dir => JSON.parse(readFileSync(join(dir, "package.json"), "utf8")).version;
const say = s => console.log(`\x1b[1mreflex\x1b[0m ${s}`);
const die = s => { console.error(`\x1b[31mreflex: ${s}\x1b[0m`); process.exit(1); };
const opt = (list, n, d) => {
  const i = list.indexOf(n);
  if (i < 0) return d;
  if (!list[i + 1] || list[i + 1].startsWith("--")) die(`${n} needs a value`);
  return list[i + 1];
};

const run = (file, extra, root = ROOT) => {
  const r = spawnSync(node(), [join(root, file), ...extra], {stdio: "inherit"});
  return r.status ?? 1;
};

// The Node the hooks will run. As found on PATH, not process.execPath: execPath is the resolved
// binary (a Homebrew Cellar or a bundled copy behind a symlink), which moves on the next upgrade,
// while the PATH entry keeps working. bunx may run this file with Bun, so never use Bun's path.
function node() {
  const found = spawnSync("sh", ["-c", "command -v node"], {encoding: "utf8"}).stdout?.trim();
  if (found) return found;
  if (!process.versions.bun) return process.execPath;
  die("Node.js 18+ is required for the hooks; install it (https://nodejs.org) and rerun");
}

// Add to the user's policy the params, flags and gates (by name / id) the bundled one has and it
// lacks; nothing of the user's is changed or reordered. A new gate goes right after the nearest
// gate before it in the bundled order that the user also has (first when there is none).
// Returns what was added.
function mergePolicy(mine, bundled) {
  const added = [];
  for (const k of ["params", "flags"])
    for (const [name, v] of Object.entries(bundled[k] ?? {})) if (!Object.hasOwn(mine[k] ??= {}, name)) { mine[k][name] = v; added.push(`${k.slice(0, -1)} ${name}`); }
  const gates = mine.gates ??= [], have = new Set(gates.map(g => g.id));
  (bundled.gates ?? []).forEach((g, i) => {
    if (have.has(g.id)) return;
    const prev = bundled.gates.slice(0, i).reverse().find(p => have.has(p.id));
    gates.splice(prev ? gates.findIndex(x => x.id === prev.id) + 1 : 0, 0, g);
    have.add(g.id);
    added.push(`gate ${g.id}`);
  });
  return added;
}

// A line from the terminal, even when stdin is a pipe (curl | bash). Hidden when `secret`.
function ask(question, secret) {
  let fd;
  try { fd = openSync("/dev/tty", "r+"); } catch { return ""; }
  const stty = a => spawnSync("stty", a, {stdio: [fd, "ignore", "ignore"]});
  try {
    writeSync(fd, question);
    if (secret) stty(["-echo"]);
    let line = "";
    const buf = Buffer.alloc(1);
    while (readSync(fd, buf, 0, 1, null) === 1 && buf[0] !== 10) line += buf.toString();
    if (secret) { stty(["echo"]); writeSync(fd, "\n"); }
    return line.trim();
  } catch { return ""; } finally { closeSync(fd); }
}

// Profiles are presets written to config.json; a flag given next to one still wins. supervised is
// the behaviour Reflex always had: a human answers every ask in the agent. autonomous puts System 2
// and an async human queue in front of the human (autonomy.mjs, docs/GUIDE.md#autonomous-agents).
// Its engine is Jev when a TypeSafe key is there, else local (keyless): the rules, the read-only list
// and the fast lane decide what they cover and System 2 judges the rest.
const PROFILES = {
  supervised: {judge: "none", queue: false, checkpoints: false},
  autonomous: {engine: "auto", mode: "enforce", allow: "on", judge: "auto", queue: true, checkpoints: true},
};
// A TypeSafe key where the hooks will look: the environment, or the Keychain item on macOS.
const inKeychain = item => platform() === "darwin" && spawnSync("security", ["find-generic-password", "-s", item], {stdio: "ignore", timeout: 2000}).status === 0;
const keychainItem = (p, keychain) => p === "typesafe" ? keychain : PROVIDERS[p].keychain;
// Only the opt-in variables choose a provider (PROVIDERS[p].detect), as in the gate.
const chooses = p => { const k = envKey(ENV, p, true); return !!k && (p !== "openrouter" || /^sk-or-/.test(k)); };
// The Jev provider (providers.mjs): --provider, else a saved or environment choice, else TypeSafe
// when config.json names its Keychain item, else jev-mcp's order over the opt-in variables and then
// the Keychain. `save`: the gate would not find it on its own (it reads the environment and
// config.json, never probes the Keychain), so config.json records it.
function pickProvider(keychain) {
  const settings = {account: opt(args, "--cloudflare-account") ?? ENV.CLOUDFLARE_ACCOUNT_ID?.trim() ?? USER_CONFIG.cloudflare_account_id,
                    url: opt(args, "--provider-url") ?? ENV.JEV_API_BASE_URL?.trim() ?? USER_CONFIG.provider_url};
  const named = opt(args, "--provider") || ENV.REFLEX_PROVIDER || ENV.JEV_PROVIDER || USER_CONFIG.provider || (USER_CONFIG.keychain && "typesafe") || null;
  const fromEnv = !named && detect(chooses, settings), fromKeychain = !named && !fromEnv && detect(p => inKeychain(keychainItem(p, keychain)), settings);
  const name = String(named || fromEnv || fromKeychain || "typesafe").toLowerCase();
  if (!PROVIDERS[name]) die(providerError(name, settings));
  const key = envKey(ENV, name) ? "environment" : inKeychain(keychainItem(name, keychain)) ? "keychain" : null;
  // A pick that used --cloudflare-account or --provider-url is saved too: the gate would not see those flags.
  const flagged = !named && name !== "typesafe" && !!(opt(args, "--cloudflare-account") || opt(args, "--provider-url"));
  return {name, settings, key, error: providerError(name, settings), save: !!opt(args, "--provider") || flagged || (!!fromKeychain && fromKeychain !== "typesafe")};
}
const hasKey = keychain => !!pickProvider(keychain).key;
const SETUP_OPTIONS = ["--mode", "--allow", "--agents", "--keychain", "--provider", "--provider-url", "--cloudflare-account", "--node", "--engine", "--profile", "--judge", "--judge-cli", "--judge-url",
  "--judge-model", "--judge-key-env", "--judge-keychain", "--judge-timeout", "--judge-budget-calls", "--judge-budget-usd", "--queue", "--queue-ttl",
  "--notify", "--checkpoints"];
const onOff = (flag, fallback) => {
  const v = opt(args, flag);
  if (v === undefined) return fallback;
  if (!["on", "off"].includes(v)) die(`${flag} must be on or off`);
  return v === "on";
};
const number = (flag, fallback) => {
  const v = opt(args, flag);
  if (v === undefined) return fallback;
  if (!/^\d+(\.\d+)?$/.test(v)) die(`${flag} must be a number`);
  return Number(v);
};
// System 2's backend when none is named: the claude CLI when it is installed (signed in, so no extra
// key; judge2.mjs runs it lean: its system prompt replaced, no tools, MCP, skills, CLAUDE.md or
// thinking), else the Messages API when ANTHROPIC_API_KEY is set, else none (uncertain decisions go
// to a human). codex is never picked on its own: `codex exec` cannot replace its base instructions,
// so every call carries them; name it with --judge cli --judge-cli codex. An OpenAI-compatible
// endpoint (OpenAI, Ollama, vLLM, LM Studio, LiteLLM, OpenRouter) is never guessed either: it takes
// --judge openai-compatible --judge-url and --judge-model. Setup says which one it picked.
function detectJudge() {
  const command = onPath("claude");
  if (command) return {backend: "cli", cli: "claude", command};
  return {backend: ENV.ANTHROPIC_API_KEY?.trim() ? "anthropic" : "none"};
}
// The ladder settings setup writes, from flags, else the profile, else what is saved.
function ladderSettings(preset) {
  const saved = USER_CONFIG, j = saved.judge ?? {};
  const chosen = opt(args, "--judge");
  if (chosen !== undefined && !JUDGE_BACKENDS.includes(chosen)) die(`--judge must be one of ${JUDGE_BACKENDS.join(", ")}`);
  let judge = {...j}, detected = false;
  if (chosen === "cli" || (chosen === undefined && opt(args, "--judge-cli"))) {
    const cli = opt(args, "--judge-cli", j.backend === "cli" ? j.cli : onPath("claude") ? "claude" : "codex");
    if (!["claude", "codex"].includes(cli)) die("--judge-cli must be claude or codex");
    const command = onPath(cli);
    if (!command) die(`--judge cli: ${cli} is not on PATH`);
    judge = {...judge, backend: "cli", cli, command};
  } else if (chosen) judge = {...judge, backend: chosen};
  else if (preset.judge === "none") judge = {...judge, backend: "none"};
  else if (preset.judge === "auto" && (!j.backend || j.backend === "none")) { judge = {...judge, ...detectJudge()}; detected = true; }
  for (const [flag, key] of [["--judge-url", "url"], ["--judge-model", "model"], ["--judge-key-env", "key_env"], ["--judge-keychain", "keychain"]]) {
    const v = opt(args, flag);
    if (v !== undefined) judge[key] = v;
  }
  if (judge.url !== undefined && judge.url !== null) { try { if (!/^https?:$/.test(new URL(judge.url).protocol)) throw 0; } catch { die("--judge-url must be an http(s) URL"); } }
  if (judge.key_env && !/^[A-Za-z_][A-Za-z0-9_]*$/.test(judge.key_env)) die("--judge-key-env takes the NAME of an environment variable, never the key");
  if (judge.backend === "openai-compatible" && (!judge.url || !judge.model)) die("--judge openai-compatible needs --judge-url and --judge-model (for example Ollama: --judge-url http://localhost:11434 --judge-model llama3.1)");
  const timeout = number("--judge-timeout"), calls = number("--judge-budget-calls"), usd = number("--judge-budget-usd");
  if (timeout !== undefined) judge.timeout_ms = timeout * 1000;
  if (calls !== undefined || usd !== undefined) judge.budget = {...j.budget, ...(calls !== undefined && {calls}), ...(usd !== undefined && {usd})};
  const q = saved.queue ?? {}, queue = {...q, enabled: onOff("--queue", preset.queue ?? q.enabled ?? false)};
  const ttl = number("--queue-ttl");
  if (ttl !== undefined) queue.ttl_hours = ttl;
  if (opt(args, "--notify") !== undefined) queue.notify = opt(args, "--notify") || null;
  return {judge, queue, checkpoints: onOff("--checkpoints", preset.checkpoints ?? saved.checkpoints ?? false), detected};
}
function describe(s) {
  const j = judgeSettings(s.judge, undefined, s.engine), q = {...QUEUE_DEFAULTS, ...s.queue};
  const key = j.key_env && ENV[j.key_env]?.trim() ? `$${j.key_env} (set)` : j.keychain ? `Keychain item ${j.keychain}`
    : j.key_env ? `$${j.key_env} (not set)` : "none (a keyless endpoint)";
  const where = j.backend === "cli" ? `cli ${j.cli} (${j.command ?? "not found"}), model ${j.model ?? "the CLI's default (pin one with --judge-model)"}, no API key`
    : `${j.backend} ${j.url}, model ${j.model}, key ${key}`;
  const picked = !s.detected ? "" : j.backend === "cli" ? " [picked because claude is installed; --judge anthropic|openai-compatible|none to change]"
    : j.backend === "anthropic" ? " [picked because ANTHROPIC_API_KEY is set; --judge to change]" : " [no claude CLI and no ANTHROPIC_API_KEY; --judge to pick one]";
  const keyless = !s.keyless ? [] : [`engine local: no TypeSafe key found ($TYPESAFE_API_KEY or Keychain item ${s.keychain}), so this is keyless autonomy: ` +
    (j.enabled ? "commands the local rules do not cover go to System 2 instead of Jev; System 2 alone allows only small commands (docs/GUIDE.md#keyless-autonomy)"
      : "with no System 2 either, every command the local rules do not cover waits in the approval queue") + "; add a key and rerun for Jev"];
  const p = s.provider, host = p && (PROVIDERS[p.name].pinned ?? hostOf(ENV.REFLEX_API_URL || providerUrl(p.name, p.settings)));
  const jev = !p ? [] : [`Jev provider ${p.name} (${host}); key ${p.key ? `in the ${p.key}` : "not found"}; the key goes to ${host} only`];
  return [`profile ${s.profile} · engine ${s.engine} · mode ${s.mode} · allow ${s.allow}`, ...jev, ...keyless,
    `System 2: ${j.enabled ? `${where}; timeout ${j.timeout_ms / 1000} s; case capped at ${j.max_input_tokens} tokens; budget ${j.budget.calls} calls${j.backend === "cli" ? "" : ` / $${j.budget.usd}`} a day` : "none (uncertain decisions go to a human)"}${picked}`,
    `queue: ${q.enabled ? `on (approvals valid ${q.ttl_hours} h, notify ${q.notify ? "on" : "off"})` : "off (a human answers in the agent)"} · checkpoints: ${s.checkpoints ? "on" : "off"}`];
}

function setup() {
  if (platform() === "win32") die("Native Windows setup is not supported yet. Run Reflex and your agent inside WSL.");
  if (USER_CONFIG_ERROR) die(USER_CONFIG_ERROR);
  for (let i = 0; i < args.length; i++) {
    if (args[i] === "--dry-run") continue;
    if (!SETUP_OPTIONS.includes(args[i])) die(`unknown setup option ${args[i]}`);
    opt(args, args[i]); i++;
  }
  if (Number(process.versions.node?.split(".")[0] ?? 99) < 18) die(`Node.js 18+ is required, found ${process.version}`);
  const profile = opt(args, "--profile");
  if (profile !== undefined && !PROFILES[profile]) die("--profile must be supervised or autonomous");
  const preset = PROFILES[profile] ?? {};
  const mode = opt(args, "--mode", preset.mode ?? ENV.REFLEX_MODE ?? USER_CONFIG.mode ?? "shadow");
  const allow = opt(args, "--allow", preset.allow ?? ENV.REFLEX_ALLOW ?? USER_CONFIG.allow ?? "off");
  // A fresh install starts local (no key needed). "Fresh" is judged from saved settings, not from
  // the package directory: the curl installer puts the package in place before running setup.
  // Settings from before `engine` existed (a Keychain item or an agent record) mean Jev was in use.
  const keychain = opt(args, "--keychain", ENV.REFLEX_KEYCHAIN_SERVICE ?? USER_CONFIG.keychain ?? "typesafe-api-key");
  const auto = preset.engine === "auto" && opt(args, "--engine") === undefined;
  // --provider names Jev's carrier, so it means engine jev unless --engine says otherwise.
  const engine = opt(args, "--engine", (opt(args, "--provider") ? "jev" : auto ? (hasKey(keychain) ? "jev" : "local") : preset.engine) ?? ENV.REFLEX_ENGINE ?? USER_CONFIG.engine ??
    (USER_CONFIG.keychain || USER_CONFIG.provider || Object.keys(USER_CONFIG.agents ?? {}).length ? "jev" : "local"));
  const provider = engine === "jev" ? pickProvider(keychain) : null;
  if (provider?.error) die(provider.error);
  const ladder = ladderSettings(preset);
  const settings = {profile: profile ?? USER_CONFIG.profile ?? "supervised", engine, mode, allow, keychain, provider, keyless: auto && engine === "local", ...ladder};
  const judgeOn = judgeSettings(settings.judge).enabled;
  if (judgeOn && mode !== "enforce") say(`note: System 2 only acts in enforce mode; in ${mode} mode it is logged as what would have happened`);
  const agents = opt(args, "--agents", ENV.REFLEX_AGENTS ?? "all");
  const nodeBin = opt(args, "--node", node());
  const nodeVersion = spawnSync(nodeBin, ["--version"], {encoding: "utf8"});
  if (nodeVersion.status !== 0 || Number(nodeVersion.stdout?.match(/^v(\d+)/)?.[1] ?? 0) < 18) die(`--node must point to Node.js 18+: ${nodeBin}`);
  const installArgs = ["--agent", agents, "--mode", mode, "--allow", allow, "--engine", engine, "--node", nodeBin, "--keychain", keychain];
  // Validate every option and preview changes before copying or changing any configuration.
  const preview = run("install.mjs", [...installArgs, "--dry-run"]);
  if (preview) process.exit(preview);
  for (const line of describe(settings)) say(line);
  say(`package: ${TARGET}; command: ${BIN_LINK}`);
  if (engine === "laya" && run("laya.mjs", ["setup", "--dry-run"])) process.exit(1);
  if (args.includes("--dry-run")) return;

  mkdirSync(policyDirectory, {recursive: true, mode: 0o700});
  if (!existsSync(join(policyDirectory, "policy.json"))) {
    // Preserve an existing installation's policy when migrating to durable configuration.
    const previous = join(TARGET, "setup/tool-gate/policy.json");
    copyFileSync(existsSync(previous) ? previous : join(ROOT, "setup/tool-gate/policy.json"), join(policyDirectory, "policy.json"));
  }
  // A policy seeded by an earlier setup lacks what later versions added (the tainted-* gates); so does
  // an injection policy the user copied (the guard reads ~/.config/reflex/injection/ first). Never seeded.
  for (const [label, userPolicy, bundled] of [["policy", join(policyDirectory, "policy.json"), "setup/tool-gate/policy.json"],
    ["injection policy", join(dirname(USER_CONFIG_FILE), "injection/policy.json"), "setup/injection/policy.json"]]) {
    if (!existsSync(userPolicy)) continue;
    try {
      const mine = JSON.parse(readFileSync(userPolicy, "utf8"));
      const added = mergePolicy(mine, JSON.parse(readFileSync(join(ROOT, bundled), "utf8")));
      if (added.length) {
        copyFileSync(userPolicy, `${userPolicy}.bak-${Date.now()}`);
        writeFileSync(userPolicy, JSON.stringify(mine, null, 2) + "\n");
        say(`${label}: added ${added.join(", ")} from this version (your gates and values are unchanged; disable a gate with its flag, since a deleted one is added back)`);
      }
    } catch (e) { say(`${label}: could not add new gates to ${userPolicy}: ${e.message}`); }
  }

  // 1. Copy the package to its stable home (replaced whole, so an upgrade leaves no stale files).
  if (realpathSync(ROOT) !== (existsSync(TARGET) ? realpathSync(TARGET) : "")) {
    const next = `${TARGET}.new-${process.pid}`;
    rmSync(next, {recursive: true, force: true});
    mkdirSync(dirname(TARGET), {recursive: true});
    cpSync(ROOT, next, {recursive: true, filter: src => !["node_modules", ".git", ".serena"].some(d => src === join(ROOT, d))});
    rmSync(TARGET, {recursive: true, force: true});
    renameSync(next, TARGET);
  }
  say(`Reflex ${version(TARGET)} in ${TARGET}`);

  // 2. The `reflex` command.
  mkdirSync(dirname(BIN_LINK), {recursive: true});
  rmSync(BIN_LINK, {force: true});
  symlinkSync(join(TARGET, "scripts/reflex"), BIN_LINK);

  // 3. The provider's key: environment, else the macOS Keychain (offered once, never written to a file).
  const item = provider && keychainItem(provider.name, keychain), envNames = provider && PROVIDERS[provider.name].env.join(" or ");
  const where = provider?.name === "typesafe" ? " Create one at https://console.typesafe.ai/keys" : "";
  if (provider && !provider.key && platform() === "darwin") {
    say(`no ${provider.name} key found.${where}`);
    const key = ask(`paste it to store it in the macOS Keychain as '${item}' (Enter to skip): `, true);
    if (key) {
      // Through `security -i` on stdin, so the key never appears in a process list.
      const quote = s => `"${String(s).replace(/(["\\])/g, "\\$1")}"`;
      const r = spawnSync("security", ["-i"], {stdio: ["pipe", "ignore", "ignore"],
        input: `add-generic-password -U -s ${quote(item)} -a ${quote(ENV.USER ?? "reflex")} -w ${quote(key)}\n`});
      say(r.status === 0 ? "key stored in the Keychain" : `could not store the key; set ${envNames} instead`);
    }
  } else if (provider && !provider.key) {
    say(`set ${envNames}${where ? ` (${where.trim().replace(/^Create one at /, "")})` : ""} in the environment your agents start from`);
  }

  // 4. The ladder settings first: install.mjs reads them to give the gate hooks room for System 2.
  let written = {};
  try { written = JSON.parse(readFileSync(USER_CONFIG_FILE, "utf8")); } catch { /* first setup */ }
  mkdirSync(dirname(USER_CONFIG_FILE), {recursive: true});
  // The provider when it was named, found in the Keychain or picked with a flag's help: one found in the
  // environment alone is found there again by every hook. --cloudflare-account and --provider-url are
  // saved whenever given. Neither is a secret; the key never lands here.
  const saved = !provider ? {} : {...(provider.save && {provider: provider.name}),
    ...(opt(args, "--cloudflare-account") && {cloudflare_account_id: opt(args, "--cloudflare-account")}),
    ...(opt(args, "--provider-url") && {provider_url: opt(args, "--provider-url")})};
  writeFileSync(USER_CONFIG_FILE, JSON.stringify({...written, profile: settings.profile, judge: settings.judge, queue: settings.queue,
    checkpoints: settings.checkpoints, ...saved}, null, 2) + "\n");
  // 5. Hook every agent, recording where the key lives so every hook finds it.
  const status = run("install.mjs", installArgs, TARGET);
  if (status !== 0) process.exit(status);

  // The Laya server: venv, pinned package, checkpoint, started (a Laya outage behaves like a Jev one).
  if (engine === "laya" && run("laya.mjs", ["setup"], TARGET)) {
    say("Laya is not running yet: until it is, System 1 falls back to the policy (reflex laya status)");
    process.exitCode = 1;
  }
  say(`installed (${engine} engine, ${mode} mode, allow ${allow})`);
  say(engine === "local" ? "local rules and instruction matches; no hosted classification or API key needed"
    : engine === "laya" ? "Laya answers on this machine (127.0.0.1); nothing is sent anywhere" : "Jev classification sends redacted context to TypeSafe");
  say(mode === "shadow" ? "shadow: deterministic rules still block; other decisions are logged only" : mode === "off" ? "off: protection is disabled"
    : judgeOn ? `enforce: ${engine === "local" ? "commands the local rules do not cover" : "uncertain commands"} go to System 2, then ${settings.queue.enabled ? "the approval queue (reflex queue)" : "a human in the agent"}`
    : settings.queue.enabled ? "enforce: uncertain commands are parked in the approval queue (reflex queue)" : "enforce: uncertain commands require human review");
  say(`editable policy: ${join(policyDirectory, "policy.json")} (preserved by upgrades)`);
  if (!(ENV.PATH ?? "").split(":").includes(dirname(BIN_LINK))) say(`add ${dirname(BIN_LINK)} to PATH to use the 'reflex' command`);
  console.log(`
Next:
  - restart your agent sessions
  - Codex: open Codex and trust the Reflex hooks in /hooks
  - Hermes: paste the printed block into each profile's config.yaml
  - check:   reflex check "git push --force origin main"
  - verify:  reflex doctor      (then reflex status after a real agent command)
  - later:   reflex report      (then: reflex setup --mode enforce)`);
}

function uninstall() {
  const root = existsSync(join(TARGET, "install.mjs")) ? TARGET : ROOT;
  if (existsSync(join(PREFIX, "laya-venv"))) { run("laya.mjs", ["uninstall-service"], root); run("laya.mjs", ["stop"], root); }
  const status = run("install.mjs", ["--agent", "all", "--uninstall", "--node", node()], root);
  if (status) process.exit(status);
  rmSync(PREFIX, {recursive: true, force: true});
  rmSync(BIN_LINK, {force: true});
  say(`removed. User settings and policy are kept beside ${USER_CONFIG_FILE}; logs are kept in ${ENV.REFLEX_DATA_DIR ?? join(ENV.XDG_STATE_HOME ?? join(homedir(), ".local/state"), "reflex")}.`);
}

// The script itself runs only when started (node reflex), never when the file is imported.
if (isMain(import.meta)) {
switch (cmd) {
  case "setup": setup(); break;
  case "uninstall": uninstall(); break;
  case "check": process.exit(run("gate.mjs", ["--check", ...args]));
  case "scan": {
    if (!args[0] || (args[0].startsWith("--") && args[0] !== "-")) die("usage: reflex scan <file|-> [--rewrite]");
    process.exit(run("guard.mjs", ["--check", ...args]));
  }
  case "status": case "doctor": process.exit(run("status.mjs", ["--" + cmd, ...args]));
  case "run": {
    if (!args[0] || args[0].startsWith("--")) die('usage: reflex run "command" [--cwd directory]');
    if (args.length !== 1 && !(args.length === 3 && args[1] === "--cwd")) die('usage: reflex run "command" [--cwd directory]');
    const r = spawnSync(node(), [join(ROOT, "gate.mjs"), "--sh", "-c", args[0]], {
      // a human is at this terminal: no System 2, no queue, no checkpoint; an ask is asked here
      cwd: opt(args, "--cwd", process.cwd()), stdio: "inherit", env: {...ENV, REFLEX_MODE: "enforce", REFLEX_ALLOW: "off",
        REFLEX_JUDGE: "off", REFLEX_QUEUE: "off", REFLEX_CHECKPOINTS: "off"}});
    if (r.error) console.error(`reflex: ${r.error.message}`);
    process.exit(r.status ?? 1);
  }
  case "trust": case "policy": process.exit(run("team.mjs", [cmd, ...args]));
  case "report": process.exit(run("report.mjs", args));
  case "audit": process.exit(run("audit.mjs", args));
  case "replay": case "bench": case "suggest": case "learn": process.exit(run("replay.mjs", [cmd, ...args]));
  case "queue": case "envelope": case "checkpoints": case "runaway": process.exit(run("autonomy.mjs", [cmd, ...args]));
  case "install": process.exit(run("install.mjs", args.includes("--agent") ? args : ["--agent", "all", ...args]));
  case "eval": process.exit(run("eval.mjs", args));
  case "laya": process.exit(run("laya.mjs", args));
  case "mcp": process.exit(run("mcp.mjs", args));
  case "test": process.exit(spawnSync("npm", ["test", "--silent"], {cwd: ROOT, stdio: "inherit"}).status ?? 1);
  case "version": case "--version": case "-v": console.log(version(ROOT)); break;
  default:
    console.error("usage: reflex setup | status | doctor | check <cmd> | scan <file|-> | run <cmd> | report | audit | replay | suggest | learn | bench | queue | envelope | checkpoints | runaway | laya | mcp | install | uninstall | test | eval | version");
    process.exit(cmd ? 2 : 0);
}
}
